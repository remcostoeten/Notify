{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": false,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "tabWidth": 4,
    "trailingComma": "none",
    "printWidth": 100,
    "bracketSpacing": true,
    "endOfLine": "lf",
    "sortPackageJson": false,
    "sortTailwindcss": {},
    "ignorePatterns": [
        "node_modules",
        ".next",
        "dist",
        "coverage",
        "pnpm-lock.yaml",
        "bun.lockb",
        "package-lock.json",
        "*.min.js",
        "*.min.css",
        "apps/docs/**"
    ]
}
