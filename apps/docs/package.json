{
  "name": "notifier-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation for @remcostoeten/notifier, built on Next.js and Fumadocs.",
  "keywords": [
    "docs",
    "documentation",
    "fumadocs",
    "mdx",
    "nextjs",
    "notifier",
    "toast"
  ],
  "homepage": "https://github.com/remcostoeten/Notify#readme",
  "bugs": {
    "url": "https://github.com/remcostoeten/Notify/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Remco Stoeten",
    "url": "https://remcostoeten.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remcostoeten/Notify.git",
    "directory": "apps/docs"
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/serve.ts dev",
    "build": "bun run check:links && bun --bun next build",
    "start": "bun scripts/serve.ts start",
    "postinstall": "bun --bun fumadocs-mdx",
    "typecheck": "bun --bun fumadocs-mdx && bun --bun next typegen && bun --bun tsc --noEmit",
    "check:links": "bun scripts/check-links.ts",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check"
  },
  "dependencies": {
    "@remcostoeten/notifier": "^3.0.0",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.17.5",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "^16.17.5",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "vite-plus": "^1.3.0"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "bun@1.4.3"
}
