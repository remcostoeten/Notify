{
    "name": "notify-monorepo",
    "version": "0.0.82",
    "private": true,
    "author": "Remco Stoeten",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "bun run build:packages",
        "build:packages": "bun run --filter='./packages/*' build",
        "typecheck": "bun run --filter='*' typecheck",
        "dev": "cd apps/docs && bun install && bun run dev",
        "dev:lib": "bun run --filter='./packages/notifier' dev",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxlint --fix --no-error-on-unmatched-pattern",
            "oxfmt --no-error-on-unmatched-pattern"
        ],
        "*.{json,md,yml,yaml,css}": [
            "oxfmt --no-error-on-unmatched-pattern"
        ]
    },
    "devDependencies": {
        "@types/node": "^22",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "husky": "^9.0.0",
        "lint-staged": "^16.0.0",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "typescript": "^5"
    },
    "packageManager": "bun@1.4.3"
}
